{
  "name": "tindae-ui-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.ts,.tsx --fix && prettier --write \"src/**/*.{vue,ts,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:check": "tsx ./scripts/check-theme-consistency.ts",
    "tokens:export": "node ./scripts/export-theme-tokens.mjs",
    "scaffold": "tsx scripts/scaffold.ts",
    "scaffold:domain": "tsx scripts/scaffold.ts domain",
    "scaffold:feature": "tsx scripts/scaffold.ts feature"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@vxe-ui/core": "4.4.18",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "highlight.js": "^11.0.0",
    "jsencrypt": "^3.5.4",
    "markdown-it": "^14.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.4.0",
    "vxe-pc-ui": "4.16.21",
    "vxe-table": "4.20.7",
    "xe-utils": "^4.0.11"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@google/design.md": "^0.3.0",
    "@types/handlebars": "^4.1.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.32",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "fast-glob": "^3.3.3",
    "handlebars": "^4.7.8",
    "jsdom": "^24.0.0",
    "less": "^4.2.0",
    "magic-string": "^0.30.21",
    "msw": "^2.14.6",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.0"
  },
  "browserslist": [
    "Chrome >= 100",
    "Edge >= 100",
    "Firefox >= 100",
    "Safari >= 15",
    "not IE > 0",
    "not dead"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
